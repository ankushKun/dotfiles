{
  "lastChangelogVersion": "0.82.0",
  "theme": "tokyo-night",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 1,
  "outputPad": 1,
  "autocompleteMaxVisible": 10,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "no-tools",
  "steeringMode": "one-at-a-time",
  "followUpMode": "all",
  "transport": "auto",
  "hideThinkingBlock": false,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 64,
    "clearOnShrink": true,
    "showTerminalProgress": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 24000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 4,
    "baseDelayMs": 1500,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "ayu": {
    "rewind": {
      "restoreOnTree": "ask"
    },
    "checkpoint": {
      "restoreOnResume": false,
      "restoreOnFork": false,
      "restoreOnClone": false,
      "maxFileMB": 5,
      "exclude": [
        "**/node_modules/**",
        "**/.venv/**",
        "**/venv/**",
        "**/__pycache__/**",
        "**/dist/**",
        "**/build/**",
        "**/target/**",
        "**/.next/**",
        "**/.turbo/**",
        "**/*.mdb",
        "**/*.sqlite",
        "**/*.db",
        "agent/npm/**",
        "agent/ayu/**",
        "agent/sessions/**",
        "agent/cache/**",
        "agent/pi-hermes-memory/**",
        "**/.pi/agent/npm/**",
        "**/.pi/agent/ayu/**",
        "**/.pi/agent/sessions/**",
        "**/.pi/agent/cache/**",
        "**/.pi/agent/pi-hermes-memory/**"
      ]
    }
  },
  "extensions": [],
  "enableSkillCommands": true,
  "defaultProjectTrust": "ask",
  "collapseChangelog": true,
  "quietStartup": true,
  "defaultProvider": "openai",
  "defaultModel": "gpt-5.6-luna",
  "packages": [
    "$HOME/.pi/agent/extensions/quiet-tool-chrome",
    "npm:pi-web-access",
    "npm:@hypabolic/pi-hypa",
    "npm:@ayulab/pi-rewind",
    "npm:@narumitw/pi-lsp",
    "npm:pi-hermes-memory",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-tool-display",
    "npm:@ff-labs/pi-fff",
    "$HOME/.pi/agent/extensions/my-pi-harness"
  ]
}
